{
  "name": "sandwich-roulette",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An animated sub sandwich order randomizer. Not affiliated with Subway.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts",
    "format": "biome check --write src scripts",
    "test": "vitest run",
    "assets:ingest": "node scripts/ingest-assets.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
